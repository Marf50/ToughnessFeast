{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release (x64)",
      "description": "Build ToughnessFeast.dll for Kenshi / RE_Kenshi",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "14"
      },
      "environment": {
        "KENSHILIB_DIR": "$penv{KENSHILIB_DIR}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows VS 17 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/cmake-build-vs2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2019",
      "displayName": "Windows VS 16 2019 x64",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/cmake-build-vs2019",
      "toolset": "v100",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "default",
      "displayName": "Default (uses env KENSHILIB_DIR)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "default-build",
      "configurePreset": "default",
      "configuration": "Release"
    }
  ]
}
